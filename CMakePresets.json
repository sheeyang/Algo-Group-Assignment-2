{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-desktop",
      "displayName": "Windows Desktop (CLI + GUI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SEAM_BUILD_GUI": true
      }
    }
  ]
}
