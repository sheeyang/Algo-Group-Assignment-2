file(MAKE_DIRECTORY "${OUTPUT_DIR}")

function(reject_dimensions name)
  set(output "${OUTPUT_DIR}/${name}.png")
  file(REMOVE "${output}")
  execute_process(COMMAND "${CLI}" "${INPUT}" "${output}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "2")
    message(FATAL_ERROR "${name}: expected usage error 2, got ${result}: ${stdout}${stderr}")
  endif()
  if(EXISTS "${output}")
    message(FATAL_ERROR "${name}: invalid dimensions wrote an output image")
  endif()
endfunction()

function(accept_dimensions name width height)
  set(output "${OUTPUT_DIR}/${name}.png")
  execute_process(COMMAND "${CLI}" "${INPUT}" "${output}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${name}: resize failed: ${stdout}${stderr}")
  endif()
  file(READ "${output}" dimensions OFFSET 16 LIMIT 8 HEX)
  string(SUBSTRING "${dimensions}" 0 8 width_hex)
  string(SUBSTRING "${dimensions}" 8 8 height_hex)
  math(EXPR actual_width "0x${width_hex}")
  math(EXPR actual_height "0x${height_hex}")
  if(NOT actual_width EQUAL width OR NOT actual_height EQUAL height)
    message(FATAL_ERROR "${name}: got ${actual_width}x${actual_height}, expected ${width}x${height}")
  endif()
endfunction()

reject_dimensions(negative-width --width -1)
reject_dimensions(negative-height --height -1)
reject_dimensions(negative-positional -1 -1 dp)
reject_dimensions(negative-positional-width -1 42 dp)
reject_dimensions(negative-positional-height 63 -1 dp)
reject_dimensions(zero-width --width 0)
reject_dimensions(too-wide --width 65)
reject_dimensions(too-tall --height 44)
accept_dimensions(omitted 64 43)
accept_dimensions(width-only 63 43 --width 63)
accept_dimensions(height-only 64 42 --height 42)
accept_dimensions(positional 63 42 63 42 dp)
accept_dimensions(percent 64 43 --percent 100)
